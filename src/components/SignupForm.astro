<form class="signup-form" id="signup-form" novalidate>
  <div class="field">
    <label class="sr-only" for="name">Nome e sobrenome</label>
    <input
      id="name"
      name="name"
      type="text"
      autocomplete="name"
      placeholder="Nome e sobrenome"
      minlength="3"
      maxlength="100"
      required
    />
    <span class="field__error" data-error-for="name"></span>
  </div>

  <div class="field">
    <label class="sr-only" for="email">Seu melhor e-mail</label>
    <input
      id="email"
      name="email"
      type="email"
      autocomplete="email"
      placeholder="Seu melhor e-mail"
      maxlength="254"
      required
    />
    <span class="field__error" data-error-for="email"></span>
  </div>

  <div class="website-field" aria-hidden="true">
    <label for="website">Não preencha este campo</label>
    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <label class="consent">
    <input name="consent" type="checkbox" required />
    <span>
      Concordo em receber informações sobre este evento por e-mail e declaro
      que li a <a href="/politica-de-privacidade" target="_blank">Política de Privacidade</a>.
    </span>
  </label>

  <button class="button button--submit" type="submit">
    <span>Fazer inscrição gratuita</span>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 12h14M14 7l5 5-5 5"></path>
    </svg>
  </button>

  <p class="form-status" role="status" aria-live="polite"></p>
  <p class="privacy-note">
    Usaremos seus dados apenas para enviar informações deste evento.
  </p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>("#signup-form");

  if (form) {
    const status = form.querySelector<HTMLElement>(".form-status");
    const button = form.querySelector<HTMLButtonElement>("button[type='submit']");

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      status!.textContent = "";
      form.querySelectorAll(".field__error").forEach((item) => {
        item.textContent = "";
      });

      if (!form.reportValidity()) return;

      button!.disabled = true;
      button!.classList.add("is-loading");
      status!.textContent = "Registrando sua inscrição...";

      try {
        const payload = Object.fromEntries(new FormData(form).entries());
        const response = await fetch("/api/inscricao", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          body: JSON.stringify(payload)
        });
        const contentType = response.headers.get("content-type") || "";
        const result = contentType.includes("application/json")
          ? await response.json()
          : { message: "Não foi possível concluir a inscrição. Tente novamente." };

        if (!response.ok) {
          if (result.fields) {
            Object.entries<string>(result.fields).forEach(([field, message]) => {
              const element = form.querySelector(`[data-error-for="${field}"]`);
              if (element) element.textContent = message;
            });
          }
          throw new Error(result.message || "Não foi possível concluir a inscrição.");
        }

        window.location.assign("/obrigado");
      } catch (error) {
        status!.textContent =
          error instanceof Error
            ? error.message
            : "Não foi possível concluir a inscrição. Tente novamente.";
        button!.disabled = false;
        button!.classList.remove("is-loading");
      }
    });
  }
</script>

<style>
  .signup-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    text-align: left;
  }

  .field {
    min-width: 0;
  }

  .field input {
    width: 100%;
    min-height: 3.2rem;
    padding: 0.75rem 1rem;
    border: 1px solid #46504e;
    border-radius: 3px;
    color: var(--ink);
    background: var(--white);
    font: inherit;
    font-size: 0.95rem;
  }

  .field input:focus {
    border-color: var(--amber);
    outline: 3px solid rgb(248 177 61 / 18%);
  }

  .field__error {
    display: block;
    min-height: 1rem;
    margin-top: 0.2rem;
    color: #ff9d8e;
    font-size: 0.7rem;
  }

  .website-field {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .consent {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1rem 1fr;
    gap: 0.6rem;
    align-items: start;
    color: var(--text-soft);
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .consent input {
    width: 1rem;
    height: 1rem;
    margin: 0.1rem 0 0;
    accent-color: var(--amber);
  }

  .consent a {
    color: var(--amber);
    font-weight: 700;
  }

  .button--submit {
    grid-column: 1 / -1;
    width: 100%;
    cursor: pointer;
  }

  .button--submit:disabled {
    cursor: wait;
    opacity: 0.72;
  }

  .form-status,
  .privacy-note {
    grid-column: 1 / -1;
    margin: 0;
    text-align: center;
  }

  .form-status {
    color: var(--amber);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .privacy-note {
    color: #84908d;
    font-size: 0.66rem;
  }

  @media (max-width: 40rem) {
    .signup-form {
      grid-template-columns: 1fr;
    }

    .consent,
    .button--submit,
    .form-status,
    .privacy-note {
      grid-column: 1;
    }
  }
</style>
